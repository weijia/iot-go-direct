{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
      "method": {
        "type": "string"
      },
      "params": {
        "type": "array",
        "items": [
          {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "[0-9a-fA-F]{8}"
              },
              "color": {
                "type": "string",
                "pattern": "([0-9a-fA-F][0-9a-fA-F])+"
              }
            },
            "required": [
              "node_id",
              "color"
            ]
          }
        ]
      }
    },
    "required": [
      "method",
      "params"
    ]
  }